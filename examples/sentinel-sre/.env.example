# LLM provider key (LiteLLM prefixes — see ai.yaml's model block). The only external credential.
GEMINI_API_KEY=your-gemini-api-key

# server.auth.type: api_key — the API/Monitor credential. Generate real ones with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINEL_API_KEY=change-me-api

# server.auth.approvers — three *distinct* approver credentials, each different from
# SENTINEL_API_KEY (otherwise the session that triggers a rollback could approve it itself).
# rollback_deploy needs any 2 of these 3, sent one at a time as the X-Approver-Key header on /resume
# (or pasted into the Monitor Playground's approver-key box).
SENTINEL_ONCALL_KEY=change-me-oncall
SENTINEL_OWNER_KEY=change-me-owner
SENTINEL_IC_KEY=change-me-ic
