# LLM provider keys (LiteLLM provider prefixes — see ai.yaml's model.primary)
GEMINI_API_KEY=your-gemini-api-key

# Required — server.auth.type: api_key checks requests against this. Generate a real one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRAVEL_PLANNER_API_KEY=change-me-to-a-real-random-secret

# Note: this example's ai.yaml doesn't set server.auth.approver_env_var, so approving
# book_flight/book_hotel through /resume uses this same key — unlike the other example
# projects, there's no distinct approver credential here.
