# LLM provider keys (LiteLLM provider prefixes — see ai.yaml's model.primary/fallback)
GEMINI_API_KEY=your-gemini-api-key

# Required — server.auth.type: api_key checks requests against this. Generate a real one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SUPPORT_DESK_API_KEY=change-me-to-a-real-random-secret

# Required — server.auth.approver_env_var. A *distinct* credential from SUPPORT_DESK_API_KEY,
# required (via the X-Approver-Key header) to approve run_diagnostic_script and any refund over
# $500 through /resume. If this equals SUPPORT_DESK_API_KEY, the same session that triggers a
# refund could also approve it itself.
SUPPORT_DESK_APPROVER_KEY=change-me-to-a-different-random-secret
