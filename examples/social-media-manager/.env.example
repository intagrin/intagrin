# LLM provider keys (LiteLLM provider prefixes — see ai.yaml's model.primary/fallback)
GEMINI_API_KEY=your-gemini-api-key

# Optional local/OpenAI-compatible endpoint, if you're pointing model.primary at one
# OPENAI_API_BASE=http://localhost:8080/v1
# OPENAI_API_KEY=sk-...

# Required — server.auth.type: api_key checks requests against this. Generate a real one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTAGRIN_API_KEY=change-me-to-a-real-random-secret

# Required — server.auth.approver_env_var. A *distinct* credential from INTAGRIN_API_KEY,
# required (via the X-Approver-Key header) to approve post_to_linkedin through /resume. If this
# equals INTAGRIN_API_KEY, the same session that triggers a post could also approve it itself.
INTAGRIN_APPROVER_KEY=change-me-to-a-different-random-secret

# Optional — only needed to actually publish to LinkedIn; without it, post_to_linkedin runs in a
# safe sandbox/demo mode that returns a mock post ID instead of hitting the real LinkedIn API.
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=
