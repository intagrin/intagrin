# LLM provider keys (LiteLLM provider prefixes — see ai.yaml's model.primary/fallback)
GEMINI_API_KEY=your-gemini-api-key

# Required — server.auth.type: api_key checks requests against this. Generate a real one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ITR_COPILOT_API_KEY=change-me-to-a-real-random-secret

# Required — server.auth.approver_env_var. A *distinct* credential from ITR_COPILOT_API_KEY,
# required (via the X-Approver-Key header) to approve generate_itr_json through /resume — every
# filing is reviewed, and a large claimed refund gets a second, explicitly-flagged review on top
# of that. If this equals ITR_COPILOT_API_KEY, the same session that triggers filing could also
# approve it itself.
ITR_COPILOT_APPROVER_KEY=change-me-to-a-different-random-secret
